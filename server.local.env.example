# Copy to server.local.env and fill in. server.local.env is gitignored: never commit it.
# Values are taken literally: no quotes, no spaces around =.

# Your login on the server.
SERVER_USER=yourname
# SHA-512 hash of your login password (used for the console and Cockpit).
# Generate in Git Bash:  openssl passwd -6
PASSWORD_HASH=
# Your time zone as an IANA name (e.g. America/Chicago). setup.ps1 fills this in from your PC.
TIMEZONE=America/Chicago
# Optional. A reusable auth key from https://login.tailscale.com/admin/settings/keys
# lets each server join your tailnet on its own. Leave empty to run
# 'sudo tailscale up --ssh' by hand after the first boot.
TAILSCALE_AUTHKEY=
# Battery charging window: starts charging below START, stops at STOP.
BATTERY_START=60
BATTERY_STOP=80
